# Para rodar fora do Docker, crie um arquivo .env a partir deste exemplo.
DATABASE_URL=mysql://rotadocaso:rotadocaso_dev@localhost:3306/rotadocaso
PORT=3000
# Gere um valor aleatório longo para produção. Exemplo no PowerShell:
# [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Mantenha "development" até contratar um provedor. Para produção com Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=contato@seudominio.com.br
EMAIL_PROVIDER=development
EMAIL_FROM_NAME=Rota do Caso
EMAIL_FROM=contato@rotadocaso.local
NEW_USER_NOTIFICATION_EMAIL=danielsantosr.rj@gmail.com
# URL publica do sistema, usada nos links seguros de envio de documentos.
# Em producao, informe a URL HTTPS definitiva, sem barra no final.
APP_URL=http://localhost:3000
# Defina como 1 somente se a aplicacao estiver atras de um proxy reverso confiavel.
# Isso permite registrar o IP real do cliente e aplicar limites por IP.
TRUST_PROXY=0
# Logs estruturados: "console" para desenvolvimento ou "file" para gravar em arquivo.
LOG_DESTINATION=console
# Usado somente quando LOG_DESTINATION=file. Caminho relativo a esta pasta do projeto.
LOG_FILE_PATH=./logs/app.log
