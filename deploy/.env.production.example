# Copie para .env.production no VPS. Este arquivo nunca deve ser enviado ao Git.
NODE_ENV=production
PORT=3000
# Para MySQL no proprio VPS (fora do Docker), use host.docker.internal e
# configure o MySQL para aceitar a rede Docker. Para banco externo, use o host
# fornecido pelo servico. Nao use 127.0.0.1 aqui: no container ele e o app.
DATABASE_URL=mysql://USUARIO:SENHA@host.docker.internal:3306/rotadocaso
AUTH_SECRET=GERE_UM_SEGREDO_LONGO_E_ALEATORIO
APP_URL=http://rotadocaso.com.br
TRUST_PROXY=1
EMAIL_PROVIDER=development
EMAIL_FROM_NAME=Rota do Caso
EMAIL_FROM=contato@rotadocaso.com.br
LOG_DESTINATION=console
