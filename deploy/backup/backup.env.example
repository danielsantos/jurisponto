# Copie para /etc/jurisponto/backup.env e aplique chmod 600 nesse arquivo.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rotadocaso
MYSQL_USER=rotadocaso_backup
MYSQL_PASSWORD=substitua-por-uma-senha-forte

# Remote rclone do tipo crypt, configurado sobre o Google Drive.
BACKUP_RCLONE_REMOTE=jurisponto_crypt:
UPLOADS_DIR=/projects/jurisponto/uploads
BACKUP_LOCAL_DIR=/var/backups/jurisponto
RETENTION_DAYS=30
MONTHLY_RETENTION_MONTHS=12

# Usado somente pelo teste mensal de restauração. Este banco será apagado ao fim.
RESTORE_TEST_DATABASE=jurisponto_restore_test
MYSQL_ADMIN_HOST=127.0.0.1
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=substitua-por-a-senha-do-admin-do-mysql
